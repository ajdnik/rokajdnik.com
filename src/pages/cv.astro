---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE, SITE_AUTHOR } from "../consts";
import CheckCircle from "../components/icons/CheckCircle.astro";
import Tag from "../components/Tag.astro";
import { cv, CV_PDF_PATH } from "../data/cv.js";

const current = cv.experience[0];
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: cv.name,
  jobTitle: current.title,
  url: cv.website,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Ljubljana",
    addressCountry: "SI",
  },
  worksFor: { "@type": "Organization", name: current.company },
  alumniOf: cv.education.map((e) => ({
    "@type": "CollegeOrUniversity",
    name: e.school,
  })),
  sameAs: [cv.linkedin, cv.github],
  knowsAbout: cv.skills
    .filter((g) => g.group !== "Spoken Languages")
    .flatMap((g) => g.items),
};
// Escape "<" so the JSON can never close the script tag.
const personJsonLd = JSON.stringify(personSchema).replace(/</g, "\\u003c");
---

<BaseLayout
  title={`CV | ${SITE_TITLE}`}
  description={`Curriculum Vitae of ${SITE_AUTHOR} - Director of Software Engineering`}
  author={SITE_AUTHOR}
  url="/cv"
>
  <script type="application/ld+json" slot="head" set:html={personJsonLd} />
  <section class="center">
    <!-- Summary -->
    <div class="mb-12">
      <p class="text-lg leading-relaxed opacity-90">{cv.summary}</p>
      <p class="mt-4 opacity-70">{cv.location}</p>
    </div>

    <!-- Experience -->
    <div class="mb-12">
      <h2 class="text-2xl font-semibold pb-4 border-b border-foreground/20 mb-6">Experience</h2>

      <div class="space-y-8">
        {cv.experience.map((e) => (
          <div class="cv-item">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-2">
              <h3 class="text-xl font-medium">{e.title}</h3>
              <span class="text-sm opacity-60">{e.start} - {e.end}</span>
            </div>
            {e.company && <p class="text-accent font-medium mb-2">{e.company}</p>}
            {e.description && (
              <p class="opacity-80">{e.description}</p>
            )}
            {e.achievementsLabel && (
              <p class="mt-3 text-sm font-medium opacity-80">{e.achievementsLabel}</p>
            )}
            {e.achievements && (
              <ul class="mt-2 list-disc space-y-1 pl-5 text-sm opacity-80 marker:text-accent">
                {e.achievements.map((a) => <li>{a}</li>)}
              </ul>
            )}
            {e.technologies && (
              <p class="mt-3 text-sm opacity-70">
                <span class="font-medium">Technologies:</span> {e.technologies.join(", ")}
              </p>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- Skills -->
    <div class="mb-12">
      <h2 class="text-2xl font-semibold pb-4 border-b border-foreground/20 mb-6">Skills</h2>

      <div class="grid sm:grid-cols-2 gap-6">
        {cv.skills.map((g) => (
          <div>
            <h3 class="font-medium mb-3 text-accent">{g.group}</h3>
            <div class="flex flex-wrap gap-2">
              {g.items.map((i) => <Tag size="md">{i}</Tag>)}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Education -->
    <div class="mb-12">
      <h2 class="text-2xl font-semibold pb-4 border-b border-foreground/20 mb-6">Education</h2>

      <div class="space-y-6">
        {cv.education.map((e) => (
          <div class="cv-item">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-2">
              <h3 class="text-xl font-medium">{e.degree}</h3>
              <span class="text-sm opacity-60">{e.start} - {e.end}</span>
            </div>
            <p class="text-accent font-medium">{e.school}</p>
            <p class="opacity-70">{e.field}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Certifications -->
    <div class="mb-12">
      <h2 class="text-2xl font-semibold pb-4 border-b border-foreground/20 mb-6">Certifications</h2>
      
      <ul class="space-y-3">
        {cv.certifications.map((c) => (
          <li class="flex items-start gap-3">
            <CheckCircle class="text-accent shrink-0 mt-1" />
            <span class="opacity-90">{c}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Patents -->
    <div class="mb-12">
      <h2 class="text-2xl font-semibold pb-4 border-b border-foreground/20 mb-6">Patents</h2>
      <div class="space-y-6">
        {cv.patents.map((p) => (
          <div class="cv-item">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-1">
              <h3 class="text-lg font-medium">
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">{p.title}</a>
                ) : (
                  p.title
                )}
              </h3>
              <span class="text-sm opacity-60 shrink-0">{p.year}</span>
            </div>
            <p class="text-sm opacity-70">{[p.number, p.status, p.assignee].filter(Boolean).join(" · ")}</p>
            <p class="text-sm opacity-60">With {p.coInventors.join(", ")}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Talks -->
    <div class="mb-12">
      <h2 class="text-2xl font-semibold pb-4 border-b border-foreground/20 mb-6">Conference Talks</h2>
      <div class="space-y-6">
        {cv.talks.map((t) => (
          <div class="cv-item">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-1">
              <h3 class="text-lg font-medium"><a href={t.url} class="hover:text-accent transition-colors">{t.title}</a></h3>
              <span class="text-sm opacity-60 shrink-0">{t.date}</span>
            </div>
            <p class="text-accent font-medium">{t.event}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Projects -->
    <div class="mb-12">
      <h2 class="text-2xl font-semibold pb-4 border-b border-foreground/20 mb-6">Projects</h2>
      <ul class="space-y-3">
        {cv.openSource.map((r) => (
          <li>
            <a href={r.url} target="_blank" rel="noopener noreferrer" class="font-medium hover:text-accent transition-colors">{r.name}</a>
            <span class="opacity-80">: {r.description}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- LinkedIn CTA -->
    <div class="flex flex-wrap items-center justify-center gap-4 pt-6">
      <a
        href={CV_PDF_PATH}
        download
        class="bg-accent text-background hover:opacity-80 inline-flex items-center gap-2 rounded-lg px-6 py-3 font-medium transition-all duration-150 ease-in-out"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        Download CV (PDF)
      </a>
      <a
        href="https://linkedin.com/in/rokajdnik"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-accent text-background hover:opacity-80 inline-flex items-center gap-2 rounded-lg px-6 py-3 font-medium transition-all duration-150 ease-in-out"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        Connect on LinkedIn
      </a>
    </div>
  </section>
</BaseLayout>
