---
interface Props {
  type?: "warning" | "note";
}

const { type = "note" } = Astro.props;

const styles = {
  warning: {
    wrapper: "border-amber-500 bg-amber-500/8",
    icon: "text-amber-500",
  },
  note: {
    wrapper: "border-accent bg-accent/8",
    icon: "text-accent",
  },
};
---

<div
  class:list={[
    "my-6 flex gap-4 rounded-xl border-l-4 px-6 py-4",
    styles[type].wrapper,
  ]}
>
  {
    type === "warning" && (
      <svg
        class:list={["mt-1 size-6 shrink-0", styles[type].icon]}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
        <path d="M12 9v4" />
        <path d="M12 17h.01" />
      </svg>
    )
  }
  <div class="text-lg leading-relaxed opacity-90 [&_p]:m-0">
    <slot />
  </div>
</div>
