---
// PostHog Component — loads analytics only after explicit consent
---
<script>
  import { disableAnalytics, enableAnalytics } from "../utils/analytics";
  import { getAnalyticsConsent, onAnalyticsConsentChange } from "../utils/consent";

  if (getAnalyticsConsent() === "granted") enableAnalytics();

  onAnalyticsConsentChange((state) => {
    if (state === "granted") enableAnalytics();
    else disableAnalytics();
  });
</script>
